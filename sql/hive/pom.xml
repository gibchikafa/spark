    </dependency>
    <dependency>
      <groupId>${hive.group}</groupId>
      <artifactId>hive-llap-common</artifactId>
      <scope>${hive.llap.scope}</scope>
    </dependency>
    <dependency>
      <groupId>${hive.group}</groupId>
      <artifactId>hive-llap-client</artifactId>
      <scope>${hive.llap.scope}</scope>
